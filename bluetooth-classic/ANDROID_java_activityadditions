native void PushDeviceName(String name);
native void PushData(String data);

public void JavaGetDeviceName(int id){
  //Toast.makeText(this, String.valueOf(id), Toast.LENGTH_SHORT).show();
  if (deviceList.isEmpty()){
    PushDeviceName("No Device Found");
    return;
  }
  
  int index = Math.floorMod(id, deviceList.size());
  //Toast.makeText(this, String.valueOf(index), Toast.LENGTH_SHORT).show();
  //if (true) return;
  BluetoothDevice device = deviceList.get(index);
  String name = device.getName();
  if (name == null){
    PushDeviceName(device.getAddress());
  } else {
    PushDeviceName(name);
  }

  PushDeviceName(name != null ? name : device.getAddress());
  return;
}

public void JavaConnectToDevice(int id){
  //First close any open sockets
  if (socket != null){
    try {
      socket.close();
    } catch (IOException ignored){
      //already closed
    }
    socket = null;
  }

  //Now create connect the socket to the device
  int index = Math.floorMod(id, deviceList.size());
  BluetoothDevice device = deviceList.get(index);
  try {
    Method m = device.getClass().getMethod("createRfcommSocket", int.class);
    socket = (BluetoothSocket) m.invoke(device, 1);
  } catch (Exception e){
    PushData(e.getMessage());
    socket = null;
    return;
  }
  if (socket != null){
    try {
      socket.connect();
    } catch (IOException e){
      PushData(e.getMessage());
      return;
      //just ignored
    }
  }
  PushData("Connected!");

  //now time to create the file and start writing to it
  String timestamp = new SimpleDateFormat("yyyyMMdd_HHmmss", Locale.US).format(new Date());
  logFile = "ble_log_" + timestamp + ".txt";
  return; 
}

public void JavaReadFromSocket(){
  if (socket == null){
    PushData("Not Connected");
    return;
  }
  InputStream in;
  try{
    in = socket.getInputStream();
  } catch (IOException e){
    PushData("Problem with input stream");
    return;
  }
  

  //check if there is available data
  try {
    if (in.available() < 1) return;
  } catch (IOException e){
    PushData("Data not available");
    return;
  }

  byte [] buffer = new byte[1024];
  int n;
  try {
    n = in.read(buffer);
  } catch (IOException e){
    PushData("Couldnt read data");
    return;
  }

  String data = new String(Arrays.copyOf(buffer, n), StandardCharsets.UTF_8);
  PushData(data);
  FileOutputStream outStream;
  File file = new File(getExternalFilesDir(null), logFile);
  try {
    outStream = new FileOutputStream(file, true); // append the data or create the file. A new file is created on every connect.
  } catch (IOException e){
    PushData(e.getMessage());
    return;
  }

  //stream opened, now to log the bytes
  try{
    outStream.write(buffer);
  } catch(IOException e){
    PushData(e.getMessage());
    return;
  }

  //close the stream
  try{
    outStream.close();
  } catch(IOException e){
    PushData(e.getMessage());
    return;
  }
  outStream = null;
  return;
}